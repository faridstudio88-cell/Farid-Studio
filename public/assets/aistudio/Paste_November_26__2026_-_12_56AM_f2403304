                  ${escapeHtml(pkg.prefix || 'FS')}-XXXX
                </span>
                <span class="text-[11px] font-semibold ${isExclusive ? 'text-slate-300' : 'text-slate-400'}">${escapeHtml(pkg.duration)}</span>
              </div>
              <h3 class="text-base font-extrabold ${isExclusive ? 'text-amber-300' : 'text-slate-900'}">${escapeHtml(pkg.name)}</h3>
              <p class="text-2xl font-black mt-2 ${isExclusive ? 'text-white' : 'text-cyan-700'}">${formattedPrice}</p>
              <p class="text-[11px] font-semibold mt-1 ${isExclusive ? 'text-amber-200/80' : 'text-indigo-600'}">${escapeHtml(pkg.cardLabel || '')}</p>
              <p class="text-xs leading-relaxed mt-3 ${isExclusive ? 'text-slate-300' : 'text-slate-600'}">${escapeHtml(pkg.benefits)}</p>
            </div>
            <button onclick="selectPackageForRegistration('${escapeHtml(pkg.id)}')" class="mt-5 w-full py-2.5 px-3 rounded-xl text-xs font-bold transition ${isExclusive ? 'bg-amber-400 hover:bg-amber-300 text-slate-950' : 'bg-cyan-600 hover:bg-cyan-700 text-white'}">
              <i class="fa-solid fa-arrow-right-to-bracket mr-1"></i> Pilih Paket Ini
            </button>
          </div>
        `;
      }).join('');
    }

    function selectPackageForRegistration(pkgId) {
      switchTab('register');
      const catSelect = document.getElementById('reg-category');
      if (catSelect) {
        catSelect.value = pkgId;
        renderInitialRegCardPreview();
      }
    }

    function togglePackageEditor() {
      if (!state.adminUnlocked) {
        openPinModal('attendance');
        return;
      }
      const editor = document.getElementById('package-admin-editor');
      if (!editor) return;
      editor.classList.toggle('hidden');
      if (!editor.classList.contains('hidden')) renderPackageEditorRows();
    }

    function renderPackageEditorRows() {
      const container = document.getElementById('package-editor-rows');
      if (!container) return;
      container.innerHTML = state.packages.map((pkg, idx) => `
        <div class="grid grid-cols-1 md:grid-cols-12 gap-2.5 bg-white p-3.5 rounded-xl border border-slate-200 items-center">
          <div class="md:col-span-2">
            <label class="block text-[10px] font-bold text-slate-500 uppercase">Kode Awalan</label>
            <input type="text" id="pkg-edit-prefix-${idx}" value="${escapeHtml(pkg.prefix || 'FS')}" maxlength="8" class="w-full mt-1 px-3 py-1.5 rounded-lg border border-slate-300 font-mono text-xs font-bold uppercase" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-[10px] font-bold text-slate-500 uppercase">Teks di Kartu</label>
            <input type="text" id="pkg-edit-cardlabel-${idx}" value="${escapeHtml(pkg.cardLabel || `Paket: ${pkg.id}`)}" class="w-full mt-1 px-3 py-1.5 rounded-lg border border-slate-300 text-xs font-semibold" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-[10px] font-bold text-slate-500 uppercase">Nama Paket</label>
            <input type="text" id="pkg-edit-name-${idx}" value="${escapeHtml(pkg.name)}" class="w-full mt-1 px-3 py-1.5 rounded-lg border border-slate-300 text-xs font-semibold" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-[10px] font-bold text-slate-500 uppercase">Harga (Rp)</label>
            <input type="number" id="pkg-edit-price-${idx}" value="${Number(pkg.price || 0)}" class="w-full mt-1 px-3 py-1.5 rounded-lg border border-slate-300 text-xs font-mono font-bold" />
          </div>
          <div class="md:col-span-3">
            <label class="block text-[10px] font-bold text-slate-500 uppercase">Benefit &amp; Masa Aktif</label>
            <input type="text" id="pkg-edit-ben-${idx}" value="${escapeHtml(pkg.benefits)}" class="w-full mt-1 px-3 py-1.5 rounded-lg border border-slate-300 text-xs" />
          </div>
          <div class="md:col-span-1 text-right pt-4">
            <button onclick="deletePackageRow(${idx})" class="px-2.5 py-1.5 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 text-xs font-bold" title="Hapus paket"><i class="fa-solid fa-trash-can"></i></button>
          </div>
        </div>
      `).join('');
    }

    function addNewPackageRow() {
      if (!state.adminUnlocked) return;
      const num = state.packages.length + 1;
      state.packages.push({
        id: `Paket_${num}`,
        prefix: `PKT${num}`,
        cardLabel: `Paket: Custom ${num}`,
        name: `Paket Baru ${num}`,
        price: 75000,
        duration: '1 Tahun',
        badge: 'Baru',
        color: 'cyan',
        benefits: 'Benefit khusus member baru Farid Studio.'
      });
      renderPackageEditorRows();
    }

    function savePackageConfigs() {
      if (!state.adminUnlocked) return;
      state.packages.forEach((pkg, idx) => {
        const prefEl = document.getElementById(`pkg-edit-prefix-${idx}`);
        const lblEl = document.getElementById(`pkg-edit-cardlabel-${idx}`);
        const nameEl = document.getElementById(`pkg-edit-name-${idx}`);
        const priceEl = document.getElementById(`pkg-edit-price-${idx}`);
        const benEl = document.getElementById(`pkg-edit-ben-${idx}`);

        if (prefEl) pkg.prefix = (prefEl.value || pkg.prefix || 'FS').trim().toUpperCase();
        if (lblEl) pkg.cardLabel = lblEl.value.trim() || `Paket: ${pkg.id}`;
        if (nameEl) {
          const newName = nameEl.value.trim();
          if (newName) {
            pkg.name = newName;
            if (!pkg.id || pkg.id.startsWith('Paket_')) pkg.id = newName;
          }
        }
        if (priceEl) pkg.price = Math.max(0, parseInt(priceEl.value, 10) || 0);
        if (benEl) pkg.benefits = benEl.value.trim() || pkg.benefits;
      });
      populatePackageSelects();
      saveDatabaseToStorage();
      renderPackagesGrid();
      renderInitialRegCardPreview();
      document.getElementById('package-admin-editor')?.classList.add('hidden');
      showToast('Pengaturan paket harga, kode seri & label kartu tersimpan!', 'success');
    }

    function deletePackageRow(idx) {
      if (!state.adminUnlocked) return;
      if (state.packages.length <= 1) {
        showToast('Minimal harus ada 1 paket member yang aktif.', 'error');
        return;
      }
      state.packages.splice(idx, 1);
      populatePackageSelects();
      saveDatabaseToStorage();
      renderPackagesGrid();
      renderPackageEditorRows();
      showToast('Paket dihapus.', 'info');
    }

    function extractCardNumberFromScan(rawText) {
      if (!rawText) return '';
      const trimmed = String(rawText).trim();
      const urlMatch = trimmed.match(/[?&]kartu=([A-Za-z0-9-]+)/i);
      if (urlMatch && urlMatch[1]) return normalizeCardNumber(urlMatch[1]);
      const fsMatch = trimmed.match(/([A-Z0-9]+-\d+)/i);
      if (fsMatch && fsMatch[1]) return normalizeCardNumber(fsMatch[1]);
      if (/^\d+$/.test(trimmed)) return normalizeCardNumber(trimmed);
      return trimmed.toUpperCase();
    }

    function handleAttendanceScanInput(val) {
      const cleaned = String(val || '').trim();
      if (/^\d{4,}$/.test(cleaned) || /^[A-Z0-9]+-\d{4,}$/i.test(cleaned) || cleaned.includes('kartu=')) {
        processAttendanceCheckIn(cleaned);
      }
    }

    function processAttendanceCheckIn(rawInput) {
      if (!state.adminUnlocked) {
        openPinModal('attendance');
        return;
      }
      const cardNo = extractCardNumberFromScan(rawInput);
      const inputEl = document.getElementById('att-scan-input');
      const feedbackEl = document.getElementById('att-scan-feedback');
      if (!cardNo) return;

      const member = state.members.find(m => m.cardNumber.toUpperCase() === cardNo.toUpperCase());
      if (!member) {
        if (feedbackEl) {
          feedbackEl.className = 'rounded-xl p-3.5 text-xs border bg-rose-950/70 border-rose-500/50 text-rose-200';
          feedbackEl.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-400 mr-1.5"></i> Nomor kartu <strong>${escapeHtml(cardNo)}</strong> tidak ditemukan di database.`;
          feedbackEl.classList.remove('hidden');
        }
        if (inputEl) inputEl.value = '';
        return;
      }

      if (member.status !== 'AKTIF') {
        if (feedbackEl) {
          feedbackEl.className = 'rounded-xl p-3.5 text-xs border bg-amber-950/70 border-amber-500/50 text-amber-200';
          feedbackEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-amber-400 mr-1.5"></i> Kartu <strong>${escapeHtml(member.cardNumber)}</strong> berstatus <strong>${escapeHtml(member.status)}</strong>. Aktifkan terlebih dahulu di Auto-ACC atau Form Daftar.`;
          feedbackEl.classList.remove('hidden');
        }
        if (inputEl) inputEl.value = '';
        return;
      }

      const purpose = document.getElementById('att-purpose')?.value || 'Sesi Foto Studio';
      const now = new Date();
      const isoDate = now.toISOString().slice(0, 10);
      const timeStr = now.toLocaleString('id-ID', {
        day: '2-digit', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit', second: '2-digit'
      });

      state.attendanceLogs.unshift({
        id: 'ATT-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
        dateKey: isoDate,
        timestamp: timeStr,
        cardNumber: member.cardNumber,
        name: member.name,
        category: member.category || 'Umum',
        phone: member.phone || '-',
        purpose
      });

      saveDatabaseToStorage();
      renderAttendanceTable();

      if (feedbackEl) {
        feedbackEl.className = 'rounded-xl p-3.5 text-xs border bg-emerald-950/80 border-emerald-500/60 text-emerald-200';
        feedbackEl.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-bold text-emerald-300"><i class="fa-solid fa-circle-check mr-1"></i> CHECK-IN BERHASIL</span>
            <span class="font-mono text-[11px] bg-emerald-500/20 px-2 py-0.5 rounded">${escapeHtml(member.cardNumber)}</span>
          </div>
          <p class="font-bold text-white text-sm mt-1">${escapeHtml(member.name)} <span class="text-xs font-normal text-emerald-300">(${escapeHtml(member.category)})</span></p>
          <p class="text-[11px] text-emerald-200/80 mt-0.5">Keperluan: ${escapeHtml(purpose)} • ${escapeHtml(timeStr)}</p>
        `;
        feedbackEl.classList.remove('hidden');
      }

      if (inputEl) {
        inputEl.value = '';
        inputEl.focus();
      }
      showToast(`Kehadiran dicatat: ${member.name} (${member.cardNumber})`, 'success');
    }

    function renderAttendanceTable() {
      const tbody = document.getElementById('attendance-table-body');
      const query = (document.getElementById('att-search-input')?.value || '').trim().toLowerCase();
      const todayKey = new Date().toISOString().slice(0, 10);

      const todayCount = state.attendanceLogs.filter(l => l.dateKey === todayKey).length;
      const uniqueCards = new Set(state.attendanceLogs.map(l => l.cardNumber)).size;

      const statToday = document.getElementById('stat-att-today');
      const statTotal = document.getElementById('stat-att-total');
      const statUnique = document.getElementById('stat-att-unique');
      if (statToday) statToday.textContent = todayCount;
      if (statTotal) statTotal.textContent = state.attendanceLogs.length;
      if (statUnique) statUnique.textContent = uniqueCards;

      if (!tbody) return;
      const filtered = state.attendanceLogs.filter(l =>
        !query ||
        l.cardNumber.toLowerCase().includes(query) ||
        l.name.toLowerCase().includes(query) ||
        l.purpose.toLowerCase().includes(query)
      );

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-slate-400">Belum ada data kehadiran member yang tercatat.</td></tr>';
        return;
      }

      tbody.innerHTML = filtered.map(log => `
        <tr class="hover:bg-slate-50">
          <td class="p-3 font-mono text-[11px] text-slate-600">${escapeHtml(log.timestamp)}</td>
          <td class="p-3 font-mono font-bold text-cyan-700">${escapeHtml(log.cardNumber)}</td>
          <td class="p-3 font-semibold text-slate-900">${escapeHtml(log.name)}</td>
          <td class="p-3"><span class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 text-[11px] font-semibold">${escapeHtml(log.category)}</span></td>
          <td class="p-3 text-slate-700">${escapeHtml(log.purpose)}</td>
          <td class="p-3 text-right">
            <button onclick="deleteAttendanceLog('${escapeHtml(log.id)}')" class="text-rose-500 hover:text-rose-700 p-1" title="Hapus baris">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </td>
        </tr>
      `).join('');
    }

    function deleteAttendanceLog(id) {
      if (!state.adminUnlocked) return;
      state.attendanceLogs = state.attendanceLogs.filter(l => l.id !== id);
      saveDatabaseToStorage();
      renderAttendanceTable();
    }

    function clearAttendanceLogs() {
      if (!state.adminUnlocked) return;
      state.attendanceLogs = [];
      saveDatabaseToStorage();
      renderAttendanceTable();
      showToast('Seluruh riwayat kehadiran studio telah dibersihkan.', 'info');
    }

    function exportAttendanceExcel() {
      if (!state.adminUnlocked) {
        openPinModal('attendance');
        return;
      }
      if (state.attendanceLogs.length === 0) {
        showToast('Belum ada data kehadiran untuk diekspor.', 'error');
        return;
      }
      const rows = state.attendanceLogs.map((l, idx) => ({
        No: idx + 1,
        'Waktu Check-In': l.timestamp,
        'Nomor Kartu': l.cardNumber,
        'Nama Member': l.name,
        'Paket Member': l.category,
        'No. WhatsApp': l.phone,
        'Keperluan Kunjungan': l.purpose
      }));
      if (typeof XLSX !== 'undefined') {
        const ws = XLSX.utils.json_to_sheet(rows);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'Kehadiran Studio');
        XLSX.writeFile(wb, `Kehadiran_FaridStudio_${new Date().toISOString().slice(0, 10)}.xlsx`);
        showToast('File Excel kehadiran studio berhasil diunduh.', 'success');
      }
    }

    async function toggleCameraScanner() {
      const wrapper = document.getElementById('camera-scanner-wrapper');
      const video = document.getElementById('attendance-video');
      const btn = document.getElementById('btn-camera-scan');
      if (!wrapper || !video || !btn) return;

      if (state.cameraStream) {
        state.cameraStream.getTracks().forEach(t => t.stop());
        state.cameraStream = null;
        if (state.cameraScanTimer) clearInterval(state.cameraScanTimer);
        wrapper.classList.add('hidden');
        btn.innerHTML = '<i class="fa-solid fa-camera mr-1"></i> Buka Kamera Scan';
        return;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        state.cameraStream = stream;
        video.srcObject = stream;
        await video.play();
        wrapper.classList.remove('hidden');
        btn.innerHTML = '<i class="fa-solid fa-stop mr-1"></i> Tutup Kamera';

        const scanCanvas = document.createElement('canvas');
        const scanCtx = scanCanvas.getContext('2d', { willReadFrequently: true });
        let lastDetected = '';
        let lastTime = 0;

        state.cameraScanTimer = setInterval(() => {
          if (!state.cameraStream || video.readyState < 2 || !video.videoWidth) return;
          try {
            scanCanvas.width = video.videoWidth;
            scanCanvas.height = video.videoHeight;
            scanCtx.drawImage(video, 0, 0, scanCanvas.width, scanCanvas.height);
            if (typeof jsQR !== 'undefined') {
              const imgData = scanCtx.getImageData(0, 0, scanCanvas.width, scanCanvas.height);
              const code = jsQR(imgData.data, imgData.width, imgData.height, { inversionAttempts: 'dontInvert' });
              if (code && code.data) {
                const now = Date.now();
                if (code.data !== lastDetected || now - lastTime > 3500) {
                  lastDetected = code.data;
                  lastTime = now;
                  processAttendanceCheckIn(code.data);
                }
              }
            }
          } catch (e) {}
        }, 350);
      } catch (err) {
        showToast('Tidak dapat mengakses kamera perangkat. Pastikan izin kamera diaktifkan.', 'error');
      }
    }

    ['mousemove', 'keydown', 'click', 'touchstart'].forEach(evt => {
      document.addEventListener(evt, resetAdminIdleTimer, { passive: true });
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && state.adminUnlocked && state.autoLockOnBlur) {
        lockAdminSession('Otomatis terkunci karena berpindah tab/aplikasi');
      }
    });

    window.addEventListener('DOMContentLoaded', async () => {
      await loadDatabaseFromStorage();
      const blurChk = document.getElementById('chk-autolock-blur');
      if (blurChk) blurChk.checked = state.autoLockOnBlur;
      syncAdminLockStates();
      initMassQrBox();
      loadDesignControlsFromState();

      const params = new URLSearchParams(window.location.search);
      const prefillCard = params.get('kartu');
      const isAutoQr = params.get('auto') === '1';
      if (prefillCard || isAutoQr || window.location.hash === '#daftar') {
        switchTab('register');
        if (prefillCard) {
          applyScannedRegistrationQr(`?kartu=${prefillCard}`);
        } else {
          renderInitialRegCardPreview();
          showToast('QR Daftar Otomatis aktif! Silakan masukkan Nomor Seri Kartu Anda.', 'success');
          document.getElementById('reg-card-number')?.focus();
        }
      } else {
        renderInitialRegCardPreview();
      }
    });
  </script>
