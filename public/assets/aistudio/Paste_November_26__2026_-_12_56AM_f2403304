        success: 'fa-circle-check text-emerald-400',
        error: 'fa-circle-exclamation text-rose-400',
        info: 'fa-circle-info text-cyan-400'
      };
      const toast = document.createElement('div');
      toast.className = `pointer-events-auto border-l-4 ${colors[type] || colors.info} px-4 py-3 rounded-xl shadow-xl text-xs font-semibold flex items-center gap-2.5 transition-all`;
      toast.innerHTML = `<i class="fa-solid ${icons[type] || icons.info} text-sm"></i><span>${escapeHtml(message)}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    async function sha256Hex(text) {
      const data = new TextEncoder().encode(String(text));
      if (window.crypto && window.crypto.subtle) {
        const hashBuf = await window.crypto.subtle.digest('SHA-256', data);
        return Array.from(new Uint8Array(hashBuf)).map(b => b.toString(16).padStart(2, '0')).join('');
      }
      let h = 0;
      for (let i = 0; i < text.length; i++) h = ((h << 5) - h) + text.charCodeAt(i);
      return 'fallback_' + Math.abs(h).toString(16);
    }

    function formatSerialDigits(num) {
      const n = Math.max(1, parseInt(num, 10) || 1);
      return n < 10000 ? String(n).padStart(4, '0') : String(n);
    }

    function normalizeCardNumber(raw, defaultPrefix) {
      const cleaned = String(raw || '').trim().toUpperCase();
      if (!cleaned) return '';
      const pref = (defaultPrefix || state.design.serialPrefix || 'FS').toUpperCase();
      if (/^\d+$/.test(cleaned)) {
        return `${pref}-${formatSerialDigits(cleaned)}`;
      }
      const match = cleaned.match(/^([A-Z0-9]+)-?(\d+)$/);
      if (match) {
        return `${match[1]}-${formatSerialDigits(match[2])}`;
      }
      return cleaned;
    }

