    function buildQrDataUrl(text, size = 160) {
      return new Promise(resolve => {
        const temp = document.createElement('div');
        temp.style.position = 'fixed';
        temp.style.left = '-9999px';
        document.body.appendChild(temp);
        new QRCode(temp, { text, width: size, height: size, colorDark: '#0b2239', colorLight: '#ffffff', correctLevel: QRCode.CorrectLevel.M });
        setTimeout(() => {
          const canvas = temp.querySelector('canvas');
          const url = canvas ? canvas.toDataURL('image/png') : '';
          temp.remove();
          resolve(url);
        }, 30);
      });
    }

    async function renderCr80DataUrl(side = 'front', options = {}) {
      const d = state.design;
      const w = 1011;
      const h = 638;
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');

      const cardNumber = options.cardNumber || `${d.serialPrefix || 'FS'}-0001`;
      const pkgId = options.category || 'Umum';
      const pkgObj = state.packages.find(p => p.id === pkgId);
      const pkgDisplayText = (options.packageDisplay !== undefined ? options.packageDisplay : d.packageDisplay) || (pkgObj ? pkgObj.cardLabel : `Paket: ${pkgId}`);
      const isDarkTheme = d.theme === 'exclusive-vip' || d.theme === 'royal-navy';

      if (side === 'front') {
        ctx.fillStyle = isDarkTheme ? d.darkColor : '#ffffff';
        ctx.fillRect(0, 0, w, h);

        // Decorative geometric header wave
        const grad = ctx.createLinearGradient(0, 0, w, 0);
        grad.addColorStop(0, d.primaryColor);
        grad.addColorStop(1, d.accentColor);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, 24);

        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.lineTo(w * 0.68, 0);
        ctx.lineTo(w * 0.56, 175);
        ctx.lineTo(0, 175);
        ctx.closePath();
        ctx.fillStyle = isDarkTheme ? 'rgba(255,255,255,0.06)' : 'rgba(0,139,163,0.08)';
        ctx.fill();

        // Brand title
        ctx.fillStyle = isDarkTheme ? '#ffffff' : d.darkColor;
        ctx.font = `900 ${d.titleSize || 48}px Inter, sans-serif`;
        ctx.textAlign = 'left';
        ctx.fillText(d.brandTitle || 'FARID STUDIO', 54, 102);

        ctx.fillStyle = d.accentColor;
        ctx.font = '700 21px Inter, sans-serif';
        ctx.fillText(`MULTIMEDIA & PHOTOGRAPHY  •  ${d.phoneText || '085241483041'}`, 54, 138);

        // Top right badge
        ctx.fillStyle = d.primaryColor;
        ctx.beginPath();
        ctx.roundRect(w - 310, 48, 256, 48, 24);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.font = '800 20px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(d.badgeLabel || 'KARTU MEMBER', w - 182, 79);

        // Package pill
        ctx.textAlign = 'left';
        ctx.fillStyle = isDarkTheme ? 'rgba(245, 158, 11, 0.2)' : 'rgba(0, 139, 163, 0.12)';
        ctx.beginPath();
        ctx.roundRect(54, 195, 420, 46, 12);
        ctx.fill();
        ctx.fillStyle = isDarkTheme ? '#fbbf24' : d.primaryColor;
        ctx.font = '800 22px Inter, sans-serif';
        ctx.fillText(pkgDisplayText, 74, 225);

        // Serial Number
        ctx.fillStyle = isDarkTheme ? '#94a3b8' : '#64748b';
        ctx.font = '700 18px Inter, sans-serif';
        ctx.fillText('NOMOR SERI KARTU MEMBER', 54, 295);

        ctx.fillStyle = isDarkTheme ? '#ffffff' : d.darkColor;
        ctx.font = '700 56px "JetBrains Mono", monospace';
        ctx.fillText(cardNumber, 54, 358);

        // Caption
        ctx.fillStyle = isDarkTheme ? '#cbd5e1' : '#475569';
        ctx.font = '500 20px Inter, sans-serif';
        const caption = d.cardCaption || '';
        ctx.fillText(caption.slice(0, 54), 54, 420);
        if (caption.length > 54) ctx.fillText(caption.slice(54, 108), 54, 448);

        // Visual Barcode Strip
        const barX = 54;
        const barY = 485;
        ctx.fillStyle = isDarkTheme ? '#ffffff' : '#0f172a';
        for (let i = 0; i < 46; i++) {
          const code = cardNumber.charCodeAt(i % cardNumber.length) + i * 7;
          const bw = (code % 3) + 2;
          if (i % 2 === 0) ctx.fillRect(barX + i * 9, barY, bw, 58);
        }
        ctx.font = '700 16px "JetBrains Mono", monospace';
        ctx.fillText(`*${cardNumber}*`, 54, 568);

        // QR Code Box
        const qrSize = Number(d.qrSize || 155);
        const qrBoxSize = qrSize + 28;
        const qrX = w - qrBoxSize - 54;
        const qrY = 230;
        ctx.fillStyle = '#ffffff';
        ctx.strokeStyle = d.primaryColor;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.roundRect(qrX, qrY, qrBoxSize, qrBoxSize, 20);
        ctx.fill();
        ctx.stroke();

        const baseUrl = window.location.href.split('#')[0].split('?')[0];
        const qrUrl = await buildQrDataUrl(`${baseUrl}?kartu=${encodeURIComponent(cardNumber)}#daftar`, qrSize);
        if (qrUrl) {
          const img = new Image();
          img.src = qrUrl;
          await new Promise(r => { img.onload = r; img.onerror = r; });
          ctx.drawImage(img, qrX + 14, qrY + 14, qrSize, qrSize);
        }

        ctx.fillStyle = isDarkTheme ? '#e2e8f0' : d.darkColor;
        ctx.font = '800 15px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(d.qrLabel || 'SCAN AKTIVASI / CEK KARTU', qrX + qrBoxSize / 2, qrY + qrBoxSize + 28);

        // Bottom strip
        ctx.fillStyle = d.primaryColor;
        ctx.fillRect(0, h - 18, w, 18);
      } else {
        // BACK SIDE
        ctx.fillStyle = d.darkColor;
        ctx.fillRect(0, 0, w, h);

        ctx.fillStyle = d.primaryColor;
        ctx.fillRect(0, 44, w, 72);

        ctx.fillStyle = '#ffffff';
        ctx.font = '800 28px Inter, sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(d.backTitle || 'SYARAT & KETENTUAN MEMBER', 54, 90);

        const rules = [
          '1. Kartu ini adalah kartu keanggotaan resmi Farid Studio Multimedia.',
          '2. Tunjukkan fisik kartu atau kartu digital saat transaksi di kasir studio.',
          '3. Berlaku untuk diskon sesi foto studio, wisuda, keluarga, dan cetak foto.',
          '4. Aktivasi mandiri dapat dilakukan dengan memindai QR Code di sisi depan.',
          '5. Kartu tidak dapat diuangkan dan berlaku sesuai masa aktif paket.'
        ];
        ctx.fillStyle = '#e2e8f0';
        ctx.font = '500 21px Inter, sans-serif';
        rules.forEach((line, idx) => {
          ctx.fillText(line, 54, 175 + idx * 44);
        });

        ctx.strokeStyle = 'rgba(255,255,255,0.18)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(54, 415);
        ctx.lineTo(w - 54, 415);
        ctx.stroke();

        ctx.fillStyle = '#38bdf8';
        ctx.font = '700 21px Inter, sans-serif';
        ctx.fillText(`Instagram: ${d.instagram || '@faridstudiomakassar'}   •   ${d.hashtag || '#AbadikanMomenBersamaFaridStudio'}`, 54, 462);

        ctx.fillStyle = '#cbd5e1';
        ctx.font = '500 19px Inter, sans-serif';
        ctx.fillText(`Studio Utama: ${d.addressMain || ''}`, 54, 512);
        ctx.fillText(`${d.addressBranch || ''}`, 54, 546);

        ctx.fillStyle = d.accentColor;
        ctx.font = '700 22px "JetBrains Mono", monospace';
        ctx.textAlign = 'right';
        ctx.fillText(cardNumber, w - 54, 595);
      }

      return canvas.toDataURL('image/png');
    }

