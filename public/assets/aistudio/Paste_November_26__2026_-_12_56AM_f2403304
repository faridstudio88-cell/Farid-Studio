    function setNextUnlimitedBatch(count) {
      const pref = (document.getElementById('batch-prefix')?.value || 'FS').toUpperCase();
      let maxNum = 0;
      state.members.forEach(m => {
        const match = m.cardNumber.match(new RegExp(`^${pref}-(\\d+)$`, 'i'));
