    function createBatchSlotsInDatabase() {
      const pkgId = document.getElementById('batch-package')?.value || 'Umum';
      const prefix = (document.getElementById('batch-prefix')?.value || 'FS').trim().toUpperCase() || 'FS';
      const start = Math.max(1, parseInt(document.getElementById('batch-start')?.value, 10) || 1);
      const end = Math.max(start, parseInt(document.getElementById('batch-end')?.value, 10) || start);
      const designLabel = getCardDesignLabel(state.design.theme);
      const createdCards = [];

      for (let i = start; i <= end; i++) {
        const cardNumber = `${prefix}-${formatSerialDigits(i)}`;
        createdCards.push(cardNumber);
        const existing = state.members.find(m => m.cardNumber.toUpperCase() === cardNumber);
        if (existing) {
          existing.category = pkgId;
          existing.cardDesign = designLabel;
        } else {
          state.members.push({
            cardNumber,
            name: 'Slot Kartu Belum Terisi',
            phone: '-',
            category: pkgId,
            cardDesign: designLabel,
            org: '-',
            address: '-',
            nik: '',
            kkNumber: '',
            kkRelation: 'Kepala Keluarga',
            ktpAddress: '',
            status: 'BELUM_AKTIF',
            registeredAt: '-',
            notes: `Batch Cetak (${designLabel})`
          });
        }
      }
      saveDatabaseToStorage();
      renderExcelTable();
      renderAdminMemberTable();
      return { createdCards, pkgId, designLabel };
    }

    function generateBatchSlotsOnly() {
      if (!state.adminUnlocked) return;
      const { createdCards } = createBatchSlotsInDatabase();
      showToast(`${createdCards.length} nomor kartu otomatis disimpan ke Data Excel Admin!`, 'success');
    }

    async function generateBatchSlotsAndPrint() {
      if (!state.adminUnlocked) return;
      saveDesignConfig(false);
      const { createdCards, pkgId } = createBatchSlotsInDatabase();
      const progressBox = document.getElementById('batch-progress-box');
      if (progressBox) {
        progressBox.textContent = `Menyiapkan ${createdCards.length} kartu CR80 untuk cetak A4...`;
        progressBox.classList.remove('hidden');
      }

      if (document.getElementById('chk-auto-export-excel')?.checked) {
        exportMembersExcel(`DataMember_FaridStudio_AutoCetak_${new Date().toISOString().slice(0, 10)}.xlsx`);
      }

      const printArea = document.getElementById('print-area');
      if (!printArea) return;
      printArea.innerHTML = '';

      const grid = document.createElement('div');
      grid.style.display = 'grid';
      grid.style.gridTemplateColumns = 'repeat(2, 85.6mm)';
      grid.style.gap = '4mm';
      grid.style.justifyContent = 'center';

      const imgPromises = [];
      for (const cardNo of createdCards) {
        const frontUrl = await renderCr80DataUrl('front', { cardNumber: cardNo, category: pkgId });
        const backUrl = await renderCr80DataUrl('back', { cardNumber: cardNo, category: pkgId });

        [frontUrl, backUrl].forEach(src => {
          const img = document.createElement('img');
          img.src = src;
          img.style.width = '85.6mm';
          img.style.height = '53.98mm';
          img.style.border = '0.2mm solid #cbd5e1';
          img.style.borderRadius = '3mm';
          grid.appendChild(img);
          if (img.decode) imgPromises.push(img.decode().catch(() => {}));
        });
      }

      printArea.appendChild(grid);
      await Promise.all(imgPromises);
      if (progressBox) progressBox.classList.add('hidden');
      window.print();
    }

