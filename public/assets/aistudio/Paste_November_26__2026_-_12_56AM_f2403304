<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Farid Studio Multimedia — Sistem Kartu Member, QR Massal &amp; Presensi</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f4f7fa;
      background-image: radial-gradient(at 0% 0%, rgba(0, 139, 163, 0.06) 0px, transparent 50%),
                        radial-gradient(at 100% 0%, rgba(14, 165, 233, 0.05) 0px, transparent 50%);
    }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    .cr80-card-shadow {
      box-shadow: 0 20px 35px -12px rgba(15, 23, 42, 0.18), 0 4px 12px -2px rgba(15, 23, 42, 0.06);
    }
    .glass-header {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    @media print {
      body * { visibility: hidden !important; }
      #print-area, #print-area * { visibility: visible !important; }
      #print-area {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: 100% !important;
        background: #fff !important;
        display: block !important;
      }
      @page { size: A4 portrait; margin: 8mm; }
    }
  </style>
</head>
<body class="text-slate-900 min-h-screen flex flex-col antialiased selection:bg-cyan-600 selection:text-white">

  <!-- TOAST NOTIFICATION -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

  <!-- HEADER & NAVIGATION -->
  <header class="glass-header border-b border-slate-200/90 sticky top-0 z-40 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between py-3.5 gap-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-cyan-600 via-teal-700 to-slate-900 text-white flex items-center justify-center shadow-md ring-2 ring-cyan-500/20">
              <i class="fa-solid fa-camera-retro text-lg"></i>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h1 class="text-base sm:text-lg font-black tracking-tight text-slate-900 leading-none">FARID STUDIO</h1>
                <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-md bg-cyan-50 border border-cyan-200/80 text-[10px] font-extrabold uppercase tracking-wider text-cyan-800">MULTIMEDIA</span>
              </div>
              <p class="text-[11px] font-medium text-slate-500 mt-1">Sistem Keanggotaan CR80, Aktivasi QR Massal &amp; Presensi Studio</p>
            </div>
          </div>
          <div id="admin-status-badge" class="lg:hidden">
            <button onclick="openPinModal('admin')" id="mobile-admin-btn" class="px-3.5 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold shadow-sm">
              <i class="fa-solid fa-lock mr-1"></i> Admin
            </button>
          </div>
        </div>

        <nav class="flex items-center gap-1.5 bg-slate-100/80 p-1.5 rounded-2xl border border-slate-200/70 overflow-x-auto">
          <button onclick="switchTab('mass-qr')" id="nav-mass-qr" class="nav-btn px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 bg-cyan-600 text-white shadow-sm whitespace-nowrap">
            <i class="fa-solid fa-qrcode"></i>
            <span>1. QR Massal</span>
          </button>
          <button onclick="switchTab('register')" id="nav-register" class="nav-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900 whitespace-nowrap">
            <i class="fa-solid fa-id-card"></i>
            <span>2. Form Daftar</span>
          </button>
          <button onclick="switchTab('portal')" id="nav-portal" class="nav-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900 whitespace-nowrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span>3. Cek Kartu</span>
          </button>
          <button onclick="openAdminTab('admin')" id="nav-admin" class="nav-btn admin-only-nav hidden px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900 whitespace-nowrap">
            <i class="fa-solid fa-user-shield"></i>
            <span>4. Admin Auto-ACC</span>
          </button>
          <button onclick="openAdminTab('design')" id="nav-design" class="nav-btn admin-only-nav hidden px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900 whitespace-nowrap">
            <i class="fa-solid fa-print"></i>
            <span>5. Cetak CR80</span>
          </button>
          <button onclick="openAdminTab('excel')" id="nav-excel" class="nav-btn admin-only-nav hidden px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900 whitespace-nowrap">
            <i class="fa-solid fa-file-excel"></i>
            <span>6. Data Excel</span>
          </button>
          <button onclick="openAdminTab('attendance')" id="nav-attendance" class="nav-btn admin-only-nav hidden px-3.5 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 text-slate-600 hover:text-slate-900 whitespace-nowrap">
            <i class="fa-solid fa-tags"></i>
            <span>7. Paket &amp; Kehadiran</span>
          </button>
          <button onclick="openPinModal('admin')" id="nav-admin-login-btn" class="px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-white whitespace-nowrap ml-1 shadow-sm">
            <i class="fa-solid fa-shield-halved text-amber-400"></i>
            <span>Login Admin</span>
          </button>
          <button onclick="lockAdminSession('Kunci manual oleh Admin')" id="nav-admin-lock-btn" class="hidden px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1.5 bg-rose-600 hover:bg-rose-700 text-white whitespace-nowrap ml-1 shadow-sm">
            <i class="fa-solid fa-lock"></i>
            <span>Kunci Admin (<span id="admin-idle-countdown">05:00</span>)</span>
          </button>
        </nav>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-7 flex-1 space-y-6">

    <!-- EXECUTIVE STATUS RIBBON -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
      <div class="bg-white rounded-2xl border border-slate-200/80 px-4 py-3.5 shadow-sm flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-cyan-50 text-cyan-700 flex items-center justify-center shrink-0">
          <i class="fa-solid fa-id-card-clip text-base"></i>
        </div>
        <div>
          <p class="text-[11px] font-semibold text-slate-500">Standar Cetak</p>
          <p class="text-xs sm:text-sm font-extrabold text-slate-900">CR80 • 300 DPI</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200/80 px-4 py-3.5 shadow-sm flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
          <i class="fa-solid fa-bolt text-base"></i>
        </div>
        <div>
          <p class="text-[11px] font-semibold text-slate-500">Aktivasi Kartu</p>
          <p class="text-xs sm:text-sm font-extrabold text-slate-900">Instan &amp; Auto-ACC</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200/80 px-4 py-3.5 shadow-sm flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center shrink-0">
          <i class="fa-solid fa-shield-halved text-base"></i>
        </div>
        <div>
          <p class="text-[11px] font-semibold text-slate-500">Privasi Identitas</p>
          <p class="text-xs sm:text-sm font-extrabold text-slate-900">Terenkripsi Admin</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200/80 px-4 py-3.5 shadow-sm flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center shrink-0">
          <i class="fa-solid fa-location-dot text-base"></i>
        </div>
        <div>
          <p class="text-[11px] font-semibold text-slate-500">Studio Utama</p>
          <p class="text-xs sm:text-sm font-extrabold text-slate-900">Sudiang • Makassar</p>
        </div>
      </div>
    </div>

    <!-- =========================================================
         TAB 1: 1 QR MASSAL PENDAFTARAN
    ========================================================== -->
    <section id="tab-mass-qr" class="tab-content space-y-6">
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6 sm:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          <div class="lg:col-span-7 space-y-5">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-50 border border-cyan-200/70 text-cyan-800 text-xs font-bold">
              <i class="fa-solid fa-bolt"></i> 1 QR Code Permanen Meja Studio &amp; Poster
            </span>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight">
              Aktivasi Kartu Member Cepat via 1 QR Massal
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              Pajang satu QR Code ini di meja kasir, backdrop studio, atau brosur resmi. Pelanggan yang memindai QR langsung diarahkan ke formulir pendaftaran mandiri, mengisi <strong>Nomor Seri Kartu</strong> yang diterima, dan status keanggotaan otomatis menjadi <strong>AKTIF</strong>.
            </p>

            <!-- 3 Langkah Singkat -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
              <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80">
                <span class="w-6 h-6 rounded-lg bg-cyan-600 text-white text-xs font-extrabold inline-flex items-center justify-center mb-2">1</span>
                <p class="text-xs font-bold text-slate-900">Scan QR Studio</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Pindai QR meja atau QR pada fisik kartu Anda.</p>
              </div>
              <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80">
                <span class="w-6 h-6 rounded-lg bg-cyan-600 text-white text-xs font-extrabold inline-flex items-center justify-center mb-2">2</span>
                <p class="text-xs font-bold text-slate-900">Isi Nomor Seri</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Masukkan kode nomor kartu &amp; data diri lengkap.</p>
              </div>
              <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80">
                <span class="w-6 h-6 rounded-lg bg-emerald-600 text-white text-xs font-extrabold inline-flex items-center justify-center mb-2">3</span>
                <p class="text-xs font-bold text-slate-900">Langsung Aktif</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Kartu digital &amp; benefit diskon langsung berlaku.</p>
              </div>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-2">
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-500">URL Pendaftaran Massal</label>
              <div class="flex flex-col sm:flex-row gap-2">
                <input type="text" id="mass-qr-url-input" readonly class="flex-1 px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 font-mono text-xs text-slate-700" />
                <button onclick="copyMassQrUrl()" class="px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition whitespace-nowrap">
                  <i class="fa-solid fa-copy mr-1.5"></i> Salin Link
                </button>
              </div>
            </div>

            <div class="flex flex-wrap gap-3 pt-1">
              <button onclick="downloadMassQrPoster()" class="px-5 py-3.5 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white text-xs font-bold transition shadow-md shadow-cyan-600/20">
                <i class="fa-solid fa-download mr-1.5"></i> Unduh Poster QR Siap Pajang (PNG)
              </button>
              <button onclick="openPublicQrAutoScanner('mass-qr')" class="px-5 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition shadow-md shadow-indigo-600/20">
                <i class="fa-solid fa-camera mr-1.5"></i> Scan QR Kartu Otomatis (Kamera)
              </button>
              <button onclick="switchTab('register')" class="px-5 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition shadow-md shadow-emerald-600/20">
                <i class="fa-solid fa-pen-to-square mr-1.5"></i> Buka Form Daftar Sekarang
              </button>
            </div>
          </div>

          <div class="lg:col-span-5 flex flex-col items-center justify-center bg-gradient-to-br from-slate-900 via-cyan-950 to-teal-900 text-white rounded-3xl p-7 sm:p-9 shadow-xl relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full bg-cyan-400/10 blur-2xl pointer-events-none"></div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-[10px] font-extrabold uppercase tracking-wider mb-3">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> QR Daftar Otomatis Aktif
            </div>
            <p class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-cyan-300 mb-1">FARID STUDIO MULTIMEDIA</p>
            <h3 class="text-lg sm:text-xl font-black mb-5 tracking-tight">SCAN QR DAFTAR MEMBER</h3>
            <div class="bg-white p-4 rounded-2xl shadow-2xl ring-4 ring-white/15">
              <div id="mass-qr-box" class="w-48 h-48 flex items-center justify-center"></div>
            </div>
            <p class="text-xs text-cyan-100/90 text-center mt-5 max-w-xs leading-relaxed">
              Arahkan kamera HP Anda ke QR di atas atau QR pada fisik kartu, sistem otomatis membuka form &amp; mengisi Nomor Seri Kartu hingga <strong class="text-white">AKTIF</strong>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================
         TAB 2: FORM PENDAFTARAN MEMBER (WAJIB NOMOR KARTU -> OTOMATIS AKTIF)
    ========================================================== -->
    <section id="tab-register" class="tab-content hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Formulir Kiri -->
        <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-bold">
              <i class="fa-solid fa-circle-check"></i> Aktivasi Instan Otomatis
            </span>
            <button type="button" onclick="openPublicQrAutoScanner('register')" class="px-3.5 py-1.5 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white text-xs font-bold transition shadow-sm flex items-center gap-1.5">
              <i class="fa-solid fa-qrcode"></i> Scan QR Kartu Otomatis
            </button>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Formulir Aktivasi Kartu Member</h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 mb-6">Wajib memasukkan <strong>Nomor Seri Kartu</strong> yang tertera pada kartu fisik Anda (atau scan QR kartu). Keanggotaan langsung aktif seketika.</p>

          <form id="member-reg-form" onsubmit="handleMemberRegistration(event)" class="space-y-4">
            <div class="bg-cyan-50/70 border border-cyan-200 rounded-xl p-4">
              <div class="flex items-center justify-between gap-2 mb-1.5">
                <label for="reg-card-number" class="block text-xs font-extrabold text-cyan-950 uppercase tracking-wider">
                  Nomor Seri Kartu Member (Wajib Diisi) <span class="text-rose-600">*</span>
                </label>
                <span id="reg-qr-auto-badge" class="hidden px-2 py-0.5 rounded-md bg-emerald-600 text-white text-[10px] font-extrabold uppercase tracking-wider">
                  <i class="fa-solid fa-qrcode mr-1"></i> Terisi Otomatis dari QR
                </span>
              </div>
              <input type="text" id="reg-card-number" required placeholder="Contoh: FS-0005, VIP-0001, EXC-0001 atau ketik 0005" oninput="handleRegCardNumberInput(this.value)" class="w-full px-4 py-3 rounded-xl bg-white border-2 border-cyan-500 font-mono text-base font-bold uppercase tracking-wider text-slate-900 focus:outline-none focus:ring-2 focus:ring-cyan-300" />
              <p id="reg-card-hint" class="text-[11px] text-cyan-800 mt-1.5">Masukkan kode awalan &amp; nomor kartu yang tertera di kartu Anda (contoh: FS-0001, VIP-0001, EXC-0001).</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="reg-name" class="block text-xs font-bold text-slate-700 mb-1">Nama Lengkap <span class="text-rose-600">*</span></label>
                <input type="text" id="reg-name" required placeholder="Contoh: Andi Muhammad Farid" oninput="renderInitialRegCardPreview()" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-cyan-600" />
              </div>
              <div>
                <label for="reg-phone" class="block text-xs font-bold text-slate-700 mb-1">Nomor WhatsApp Aktif <span class="text-rose-600">*</span></label>
                <input type="tel" id="reg-phone" required placeholder="0852xxxxxxxx" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-cyan-600" />
              </div>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 flex items-center gap-2.5 text-xs text-slate-600">
              <i class="fa-solid fa-shield-halved text-cyan-700 text-base"></i>
              <span>Verifikasi identitas KTP &amp; Kartu Keluarga (KK) dikelola secara rahasia oleh Admin studio setelah aktivasi.</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="reg-category" class="block text-xs font-bold text-slate-700 mb-1">Pilihan Paket Member <span class="text-rose-600">*</span></label>
                <select id="reg-category" onchange="renderInitialRegCardPreview()" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm bg-white focus:outline-none focus:border-cyan-600"></select>
              </div>
              <div>
                <label for="reg-org" class="block text-xs font-bold text-slate-700 mb-1">Instansi / Kampus / Komunitas</label>
                <input type="text" id="reg-org" placeholder="Contoh: UNHAS / Umum Makassar" oninput="renderInitialRegCardPreview()" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-cyan-600" />
              </div>
            </div>

            <div>
              <label for="reg-address" class="block text-xs font-bold text-slate-700 mb-1">Alamat Domisili</label>
              <input type="text" id="reg-address" placeholder="Contoh: Jl. Perintis Kemerdekaan, Makassar" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-cyan-600" />
            </div>

            <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-cyan-600 to-teal-700 hover:from-cyan-700 hover:to-teal-800 text-white font-bold text-sm shadow-md transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-bolt"></i> Daftar &amp; Aktifkan Member Otomatis
            </button>
          </form>
        </div>

        <!-- Panel Kanan: Pratinjau Kartu & Data Asli Kartu Aktif -->
        <div class="lg:col-span-5 space-y-5">
          <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm p-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-bold text-slate-900">Pratinjau Kartu Member Digital</h3>
              <span id="reg-live-status-badge" class="px-2.5 py-0.5 rounded-full bg-cyan-50 text-cyan-800 text-[11px] font-bold">SIAP AKTIVASI</span>
            </div>
            <div class="rounded-2xl overflow-hidden border border-slate-200/90 bg-slate-50 cr80-card-shadow">
              <img id="reg-live-card-img" alt="Pratinjau Kartu Member" class="w-full h-auto block" />
            </div>
            <p class="text-[11px] text-slate-500 mt-3 leading-relaxed">
              Catatan privasi: Fisik kartu cetak tidak menampilkan biodata terbuka. Data lengkap hanya dapat diakses oleh pemilik nomor seri dan Admin.
            </p>
          </div>

          <!-- Box Data Asli Kartu Aktif (Muncul otomatis jika nomor kartu sudah terdaftar aktif) -->
          <div id="ereceipt-box" class="hidden bg-emerald-50 border border-emerald-200 rounded-2xl p-5 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-extrabold text-emerald-800 uppercase tracking-wider">
                <i class="fa-solid fa-shield-check mr-1"></i> Data Asli Kartu Member Aktif
              </span>
              <span id="er-card-no" class="font-mono text-xs font-bold bg-emerald-600 text-white px-2.5 py-0.5 rounded-lg">FS-0001</span>
            </div>
            <div class="bg-white rounded-xl p-3.5 border border-emerald-200 text-xs space-y-1.5">
              <p><span class="text-slate-500">Nama Pemilik:</span> <strong id="er-name" class="text-slate-900">-</strong></p>
