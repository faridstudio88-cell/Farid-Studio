    function updateLockoutUi() {
      const banner = document.getElementById('pin-lockout-banner');
      const timerEl = document.getElementById('pin-lockout-timer');
      const verifyBtn = document.getElementById('btn-verify-admin');
      const now = Date.now();
      if (state.lockoutUntil > now) {
        const secs = Math.ceil((state.lockoutUntil - now) / 1000);
        if (banner) banner.classList.remove('hidden');
        if (timerEl) timerEl.textContent = secs;
        if (verifyBtn) verifyBtn.disabled = true;
      } else {
        if (banner) banner.classList.add('hidden');
        if (verifyBtn) verifyBtn.disabled = false;
      }
    }

    async function verifyAdminPin() {
      const now = Date.now();
      if (state.lockoutUntil > now) {
        updateLockoutUi();
        return;
      }
      const pinVal = (document.getElementById('admin-pin-input')?.value || '').trim();
      const mkVal = (document.getElementById('admin-master-key-input')?.value || '').trim().toUpperCase();

      const enteredPinHash = await sha256Hex(pinVal);
      const enteredMkHash = await sha256Hex(mkVal);

      if (enteredPinHash === state.pinHash && enteredMkHash === state.masterKeyHash) {
        state.failedAttempts = 0;
        state.lockoutUntil = 0;
        state.adminUnlocked = true;
        addSecurityLog('Login Admin 2FA berhasil', 'INFO');
        saveDatabaseToStorage();
        closePinModal();
        syncAdminLockStates();
        startAdminIdleTimer();
        showToast('Akses Admin Super Ketat berhasil dibuka!', 'success');
        if (state.pendingTargetTab) {
          const nextTab = state.pendingTargetTab;
          state.pendingTargetTab = null;
          switchTab(nextTab);
        }
      } else {
        state.failedAttempts += 1;
        addSecurityLog(`Percobaan login Admin gagal (${state.failedAttempts}/3)`, 'WARN');
        if (state.failedAttempts >= 3) {
          state.lockoutUntil = Date.now() + 60000;
          state.failedAttempts = 0;
          addSecurityLog('Kunci sementara 60 detik aktif karena 3x gagal login', 'ALERT');
          if (state.lockoutInterval) clearInterval(state.lockoutInterval);
          state.lockoutInterval = setInterval(() => {
            updateLockoutUi();
            if (Date.now() >= state.lockoutUntil) {
              clearInterval(state.lockoutInterval);
            }
          }, 500);
        }
        saveDatabaseToStorage();
        updateLockoutUi();
        showToast('PIN Admin atau Master Security Key salah!', 'error');
      }
    }

    function startAdminIdleTimer() {
      state.idleSecondsLeft = 300;
      if (state.idleInterval) clearInterval(state.idleInterval);
      state.idleInterval = setInterval(() => {
        if (!state.adminUnlocked) {
          clearInterval(state.idleInterval);
          return;
        }
        state.idleSecondsLeft -= 1;
        const mins = String(Math.floor(Math.max(0, state.idleSecondsLeft) / 60)).padStart(2, '0');
        const secs = String(Math.max(0, state.idleSecondsLeft) % 60).padStart(2, '0');
        const cdEl = document.getElementById('admin-idle-countdown');
        if (cdEl) cdEl.textContent = `${mins}:${secs}`;
        if (state.idleSecondsLeft <= 0) {
          lockAdminSession('Otomatis terkunci karena idle 5 menit');
        }
      }, 1000);
    }

    function resetAdminIdleTimer() {
      if (state.adminUnlocked) {
        state.idleSecondsLeft = 300;
