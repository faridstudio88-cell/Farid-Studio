    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const colors = {
        success: 'bg-emerald-900 border-emerald-500 text-white',
        error: 'bg-rose-900 border-rose-500 text-white',
