    async function openPublicQrAutoScanner(sourceTab = 'register') {
      const modal = document.getElementById('public-qr-scanner-modal');
      const video = document.getElementById('public-qr-video');
      if (!modal || !video) return;

      closePublicQrAutoScanner();
      modal.classList.remove('hidden');

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        state.publicQrStream = stream;
        video.srcObject = stream;
        await video.play();

        const scanCanvas = document.createElement('canvas');
        const scanCtx = scanCanvas.getContext('2d', { willReadFrequently: true });

        state.publicQrTimer = setInterval(() => {
          if (!state.publicQrStream || video.readyState < 2 || !video.videoWidth) return;
          try {
            scanCanvas.width = video.videoWidth;
            scanCanvas.height = video.videoHeight;
            scanCtx.drawImage(video, 0, 0, scanCanvas.width, scanCanvas.height);
            if (typeof jsQR !== 'undefined') {
              const imgData = scanCtx.getImageData(0, 0, scanCanvas.width, scanCanvas.height);
              const code = jsQR(imgData.data, imgData.width, imgData.height, { inversionAttempts: 'dontInvert' });
              if (code && code.data) {
                closePublicQrAutoScanner();
                applyScannedRegistrationQr(code.data);
              }
            }
          } catch (e) {}
        }, 320);
      } catch (err) {
        closePublicQrAutoScanner();
        if (sourceTab !== 'register') switchTab('register');
        showToast('Kamera tidak tersedia. Silakan ketik Nomor Seri Kartu Anda secara manual.', 'info');
        document.getElementById('reg-card-number')?.focus();
      }
    }

    function closePublicQrAutoScanner() {
      if (state.publicQrTimer) {
        clearInterval(state.publicQrTimer);
        state.publicQrTimer = null;
      }
      if (state.publicQrStream) {
        state.publicQrStream.getTracks().forEach(t => t.stop());
        state.publicQrStream = null;
      }
      document.getElementById('public-qr-scanner-modal')?.classList.add('hidden');
    }

    function applyScannedRegistrationQr(rawData) {
      switchTab('register');
      const cardNo = extractCardNumberFromScan(rawData);
      const cardInput = document.getElementById('reg-card-number');
      const autoBadge = document.getElementById('reg-qr-auto-badge');

      if (cardNo && cardNo !== 'HTTP' && !cardNo.startsWith('HTTP')) {
        if (cardInput) cardInput.value = cardNo;
        autoBadge?.classList.remove('hidden');

        const prefixMatch = cardNo.match(/^([A-Z0-9]+)-/);
        if (prefixMatch) {
          const matchedPkg = state.packages.find(p => (p.prefix || '').toUpperCase() === prefixMatch[1]);
          const catSelect = document.getElementById('reg-category');
          if (matchedPkg && catSelect) catSelect.value = matchedPkg.id;
        }
        handleRegCardNumberInput(cardNo);
        showToast(`QR Kartu ${cardNo} terbaca otomatis!`, 'success');
      } else {
        autoBadge?.classList.add('hidden');
        renderInitialRegCardPreview();
        showToast('QR Daftar Otomatis terbuka! Masukkan Nomor Seri Kartu Anda.', 'success');
        cardInput?.focus();
      }
    }

