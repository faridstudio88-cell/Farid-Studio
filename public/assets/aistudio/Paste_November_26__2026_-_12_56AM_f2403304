      if (regSel) {
        const cur = regSel.value;
        regSel.innerHTML = state.packages.map(p =>
          `<option value="${escapeHtml(p.id)}">${escapeHtml(p.name)} (${escapeHtml(p.prefix || 'FS')}-XXXX)</option>`
        ).join('');
        if (cur && state.packages.some(p => p.id === cur)) regSel.value = cur;
