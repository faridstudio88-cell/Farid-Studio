    function exportMembersExcel(customFilename) {
      if (!state.adminUnlocked) {
        openPinModal('excel');
        return;
      }
      if (typeof XLSX === 'undefined') {
        showToast('Library Excel belum siap.', 'error');
        return;
      }
      const rows = state.members.map((m, idx) => ({
        No: idx + 1,
        'Nomor Kartu': m.cardNumber,
        'Nama Lengkap': m.name,
        'No. WhatsApp': m.phone || '-',
        'Paket Member': m.category || 'Umum',
        'Jenis Desain Kartu': m.cardDesign || getCardDesignLabel(state.design.theme),
        'Instansi / Kampus': m.org || '-',
        'NIK KTP': m.nik || '',
        'Nomor KK': m.kkNumber || '',
        'Status': m.status,
        'Tanggal Aktif': m.registeredAt || '-',
        'Catatan': m.notes || ''
      }));
      const ws = XLSX.utils.json_to_sheet(rows);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, 'Data Member');
      XLSX.writeFile(wb, customFilename || `DataMember_FaridStudio_${new Date().toISOString().slice(0, 10)}.xlsx`);
      showToast('File Excel Data Member (.xlsx) berhasil diunduh!', 'success');
    }

    function importMembersExcel(event) {
      if (!state.adminUnlocked) return;
      const file = event.target.files?.[0];
      if (!file || typeof XLSX === 'undefined') return;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(e.target.result, { type: 'array' });
          const sheet = wb.Sheets[wb.SheetNames[0]];
          const json = XLSX.utils.sheet_to_json(sheet);
          let importedCount = 0;
          json.forEach(row => {
            const rawCard = row['Nomor Kartu'] || row['No. Kartu'] || row['cardNumber'];
            if (!rawCard) return;
            const cardNumber = normalizeCardNumber(rawCard);
            const record = {
              cardNumber,
              name: String(row['Nama Lengkap'] || row['Nama'] || 'Member Import'),
              phone: String(row['No. WhatsApp'] || row['WhatsApp'] || '-'),
              category: String(row['Paket Member'] || row['Paket'] || 'Umum'),
              cardDesign: String(row['Jenis Desain Kartu'] || getCardDesignLabel(state.design.theme)),
              org: String(row['Instansi / Kampus'] || '-'),
              address: String(row['Alamat'] || '-'),
              nik: String(row['NIK KTP'] || ''),
              kkNumber: String(row['Nomor KK'] || ''),
              kkRelation: 'Kepala Keluarga',
              ktpAddress: '',
              status: String(row['Status'] || 'AKTIF').toUpperCase() === 'AKTIF' ? 'AKTIF' : 'BELUM_AKTIF',
              registeredAt: String(row['Tanggal Aktif'] || new Date().toLocaleDateString('id-ID')),
              notes: String(row['Catatan'] || 'Import Excel')
            };
            const idx = state.members.findIndex(m => m.cardNumber.toUpperCase() === cardNumber.toUpperCase());
            if (idx >= 0) state.members[idx] = record;
            else state.members.push(record);
            importedCount++;
          });
          saveDatabaseToStorage();
          renderExcelTable();
          renderAdminMemberTable();
          showToast(`${importedCount} baris data berhasil diimpor dari Excel!`, 'success');
        } catch (err) {
          showToast('Gagal membaca file Excel. Pastikan format kolom sesuai.', 'error');
        }
        event.target.value = '';
      };
      reader.readAsArrayBuffer(file);
    }

