    async function loadDatabaseFromStorage() {
      const defaultPinHash = await sha256Hex(DEFAULT_PIN_PLAIN);
      const defaultMkHash = await sha256Hex(DEFAULT_MASTER_KEY_PLAIN);
      state.pinHash = defaultPinHash;
      state.masterKeyHash = defaultMkHash;

      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed.pinHash) state.pinHash = parsed.pinHash;
          if (parsed.masterKeyHash) state.masterKeyHash = parsed.masterKeyHash;
          if (typeof parsed.autoLockOnBlur === 'boolean') state.autoLockOnBlur = parsed.autoLockOnBlur;
          if (Array.isArray(parsed.securityLogs)) state.securityLogs = parsed.securityLogs;
          if (parsed.design) state.design = { ...DEFAULT_DESIGN, ...parsed.design };
          if (Array.isArray(parsed.packages) && parsed.packages.length > 0) state.packages = parsed.packages;
          if (Array.isArray(parsed.members)) state.members = parsed.members;
          if (Array.isArray(parsed.attendanceLogs)) state.attendanceLogs = parsed.attendanceLogs;
        } else {
          state.members = seedInitialMembers();
          saveDatabaseToStorage();
        }
      } catch (e) {
        state.members = seedInitialMembers();
      }
      populatePackageSelects();
    }

    function saveDatabaseToStorage() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
          pinHash: state.pinHash,
          masterKeyHash: state.masterKeyHash,
          autoLockOnBlur: state.autoLockOnBlur,
          securityLogs: state.securityLogs,
          design: state.design,
          packages: state.packages,
          members: state.members,
          attendanceLogs: state.attendanceLogs
        }));
      } catch (e) {
        console.warn('Gagal menyimpan ke localStorage:', e);
      }
    }

